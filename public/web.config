<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <directoryBrowse enabled="false" />
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <remove name="X-Content-Type-Options" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <remove name="X-Frame-Options" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <remove name="Referrer-Policy" />
        <add name="Referrer-Policy" value="no-referrer" />
        <remove name="Permissions-Policy" />
        <add name="Permissions-Policy" value="camera=(), microphone=(), payment=()" />
        <remove name="Content-Security-Policy" />
        <add name="Content-Security-Policy" value="base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'" />
      </customHeaders>
    </httpProtocol>
    <!-- Configuración de Reescritura de URLs -->
    <rewrite>
      <rules>
        <rule name="Block sensitive artifacts" stopProcessing="true">
          <match url="(^|/)\.(?!well-known(/|$))|\.(map|log|sql|bak|old|orig|save|env|ini|yaml|yml|zip|tar|7z|rar|php|phtml|phar)$|^(package(-lock)?\.json|composer\.(json|lock)|web\.config|(README|SECURITY)(\.[^/]+)?)$" ignoreCase="true" />
          <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Not Found" />
        </rule>
        <!-- 1. Forzar redirección de HTTP a HTTPS -->
        <rule name="Redirect to HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions logicalGrouping="MatchAll">
            <add input="{HTTPS}" pattern="off" ignoreCase="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>

        <!-- 2. Redirecciones permanentes 301 para migración de URLs -->
        <rule name="Redirect quines-somos" stopProcessing="true">
          <match url="^quines-somos/?$" />
          <action type="Redirect" url="/quienes-somos" redirectType="Permanent" />
        </rule>
        <rule name="Redirect polticas" stopProcessing="true">
          <match url="^polticas/?$" />
          <action type="Redirect" url="/politicas" redirectType="Permanent" />
        </rule>
        <rule name="Redirect juntaDirecteEquipo" stopProcessing="true">
          <match url="^juntaDirecteEquipo/?$" />
          <action type="Redirect" url="/junta-directiva-equipo" redirectType="Permanent" />
        </rule>
        <rule name="Redirect proyectos-activos" stopProcessing="true">
          <match url="^proyectos-activos/?$" />
          <action type="Redirect" url="/proyectos" redirectType="Permanent" />
        </rule>
        <rule name="Redirect companies" stopProcessing="true">
          <match url="^companies/?$" />
          <action type="Redirect" url="/empresas" redirectType="Permanent" />
        </rule>
        <rule name="Redirect profile" stopProcessing="true">
          <match url="^profile/?$" />
          <action type="Redirect" url="/perfil" redirectType="Permanent" />
        </rule>
        <rule name="Redirect terms" stopProcessing="true">
          <match url="^terms/?$" />
          <action type="Redirect" url="/terminos" redirectType="Permanent" />
        </rule>
        <rule name="Redirect privacy" stopProcessing="true">
          <match url="^privacy/?$" />
          <action type="Redirect" url="/privacidad" redirectType="Permanent" />
        </rule>

        <!-- 3. Enrutamiento para React Router (SPA) -->
        <rule name="React Routes" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{REQUEST_URI}" pattern="^/(api)" negate="true" />
          </conditions>
          <action type="Rewrite" url="/" />
        </rule>
      </rules>
    </rewrite>

    <!-- Tipos MIME para asegurar la correcta entrega de recursos estáticos en IIS -->
    <staticContent>
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".woff" />
      <mimeMap fileExtension=".woff" mimeType="application/font-woff" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="application/font-woff2" />
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".avif" />
      <mimeMap fileExtension=".avif" mimeType="image/avif" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <remove fileExtension=".jfif" />
      <mimeMap fileExtension=".jfif" mimeType="image/jpeg" />
    </staticContent>

    <!-- Redirigir errores de IIS directamente a la aplicación -->
    <httpErrors errorMode="DetailedLocalOnly" existingResponse="Auto" />
  </system.webServer>
</configuration>
